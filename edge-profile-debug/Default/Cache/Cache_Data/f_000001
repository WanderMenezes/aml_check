<!doctype html>
<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AML Check Enterprise</title>
    <style>
      :root {
        --bg: #07111a;
        --panel: #0d1822;
        --panel-strong: #08141f;
        --panel-soft: rgba(255, 255, 255, 0.045);
        --line: rgba(255, 255, 255, 0.1);
        --text: #f5fbff;
        --muted: #93a4b4;
        --teal: #0fb7a7;
        --gold: #dab66b;
        --danger: #de5b6d;
        --warning: #e7a63a;
        --success: #23b26d;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Segoe UI", Arial, sans-serif;
        background:
          radial-gradient(circle at 18% 0%, rgba(15, 183, 167, 0.16), transparent 30%),
          linear-gradient(180deg, #07111a 0%, #0a1620 100%);
        color: var(--text);
      }

      a { color: inherit; text-decoration: none; }

      .shell {
        display: grid;
        grid-template-columns: 286px minmax(0, 1fr);
        gap: 24px;
        min-height: 100vh;
        padding: 24px;
      }

      .sidebar {
        position: sticky;
        top: 24px;
        height: calc(100vh - 48px);
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 18px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(8, 20, 31, 0.96);
        padding: 18px;
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
      }

      .brand h1 {
        margin: 10px 0 6px;
        font-size: 23px;
        line-height: 1.1;
      }

      .brand p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .sidebar-section {
        display: grid;
        gap: 8px;
      }

      .sidebar-heading {
        margin: 0 0 2px;
        color: var(--muted);
        font-size: 11px;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      .nav-link,
      .metric-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.035);
        padding: 11px 12px;
        color: var(--text);
        font-size: 14px;
      }

      .nav-link:hover,
      .metric-link:hover {
        border-color: rgba(15, 183, 167, 0.45);
        background: rgba(15, 183, 167, 0.11);
      }

      .nav-link span:last-child,
      .metric-link span:last-child {
        color: var(--muted);
        font-size: 12px;
      }

      .language-control {
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        background: rgba(7, 17, 26, 0.72);
        padding: 8px;
        color: var(--muted);
        font-size: 13px;
      }

      .lang-button {
        min-width: 42px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: transparent;
        color: var(--text);
        padding: 8px 10px;
        cursor: pointer;
      }

      .lang-button.is-active {
        background: var(--teal);
        color: #051117;
        font-weight: 700;
      }

      .content {
        min-width: 0;
        max-width: 1520px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(300px, .9fr);
        gap: 20px;
      }

      .card,
      .panel,
      .stat,
      .notice,
      .report-strip {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel-soft);
        backdrop-filter: blur(12px);
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
      }

      .card { padding: 22px; }

      .hero-panel {
        min-height: 220px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 28px;
      }

      .hero-panel h2,
      .hero-panel h1 {
        margin: 10px 0 8px;
      }

      .hero-panel h1 { font-size: 38px; }
      .hero-panel p { color: var(--muted); max-width: 760px; }

      .pill {
        display: inline-flex;
        align-items: center;
        border: 1px solid rgba(15, 183, 167, 0.24);
        border-radius: 999px;
        background: rgba(15, 183, 167, 0.08);
        color: var(--teal);
        padding: 7px 10px;
        font-size: 12px;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .links,
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .links { margin-top: 18px; }

      .link-btn,
      .action-btn,
      button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--text);
        font-weight: 700;
        padding: 10px 13px;
        cursor: pointer;
      }

      button.primary,
      .action-btn.primary {
        border-color: transparent;
        background: var(--teal);
        color: #051117;
      }

      .action-btn.gold {
        border-color: rgba(218, 182, 107, 0.35);
        background: rgba(218, 182, 107, 0.13);
        color: #f2d99b;
      }

      .mini {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .item {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(7, 17, 26, 0.72);
        padding: 15px;
      }

      .mini .item strong {
        display: block;
        margin-bottom: 6px;
        font-size: 24px;
      }

      .muted { color: var(--muted); }

      .stats {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 14px;
        margin-top: 20px;
      }

      .stat {
        padding: 17px;
      }

      .stat small {
        display: block;
        margin-bottom: 12px;
        color: var(--muted);
      }

      .stat strong { font-size: 30px; }

      .notice {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        margin-top: 20px;
        padding: 18px;
        border-color: rgba(15, 183, 167, 0.3);
        background: rgba(15, 183, 167, 0.08);
      }

      .notice strong {
        display: block;
        margin-top: 10px;
        font-size: 18px;
      }

      .notice p { margin: 8px 0 0; color: var(--muted); }

      .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.16fr) minmax(340px, .9fr);
        gap: 20px;
        margin-top: 20px;
      }

      .section-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 16px;
      }

      .section-title h2 {
        margin: 10px 0 0;
        font-size: 22px;
      }

      .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .search-mode {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 16px;
      }

      .search-mode label {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        margin: 0;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(7, 17, 26, 0.72);
        color: var(--text);
        padding: 10px 12px;
        cursor: pointer;
      }

      .search-mode input { width: auto; }

      .mode-help {
        margin: -4px 0 16px;
        color: var(--muted);
        font-size: 13px;
      }

      .is-hidden { display: none !important; }

      label {
        display: block;
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 13px;
      }

      input,
      textarea,
      select {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: rgba(7, 17, 26, 0.92);
        color: var(--text);
        padding: 13px 14px;
      }

      textarea {
        min-height: 100px;
        resize: vertical;
      }

      select {
        min-height: 46px;
      }

      .portal-messages {
        display: grid;
        gap: 10px;
        margin-top: 20px;
      }

      .portal-message {
        border: 1px solid rgba(15, 183, 167, 0.28);
        border-radius: 8px;
        background: rgba(15, 183, 167, 0.1);
        color: var(--text);
        padding: 12px 14px;
      }

      .portal-message.error {
        border-color: rgba(222, 91, 109, 0.34);
        background: rgba(222, 91, 109, 0.12);
      }

      .admin-tools {
        scroll-margin-top: 18px;
      }

      .admin-toolbar {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 16px;
      }

      .admin-form {
        display: grid;
        gap: 14px;
      }

      .source-link {
        display: block;
        margin-top: 6px;
        color: var(--teal);
        overflow-wrap: anywhere;
      }

      .table-wrap {
        overflow-x: auto;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
      }

      table {
        width: 100%;
        min-width: 820px;
        border-collapse: collapse;
      }

      th,
      td {
        border-bottom: 1px solid rgba(255,255,255,0.06);
        padding: 14px 12px;
        text-align: left;
        vertical-align: top;
      }

      th {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
      }

      tbody tr:last-child td { border-bottom: 0; }

      .risk {
        display: inline-flex;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .06em;
      }

      .LOW { background: rgba(35,178,109,.16); color: #8ff0bb; }
      .MEDIUM { background: rgba(231,166,58,.16); color: #ffd07d; }
      .HIGH { background: rgba(255,132,66,.16); color: #ffc099; }
      .CRITICAL { background: rgba(222,91,109,.16); color: #ffb2bc; }

      .list {
        display: grid;
        gap: 12px;
      }

      .report-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 14px;
        background: rgba(7, 17, 26, 0.72);
      }

      .report-strip strong {
        display: block;
        margin-bottom: 5px;
      }

      .inline-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .inline-actions button {
        min-height: 34px;
        padding: 8px 10px;
        font-size: 12px;
      }

      @media (max-width: 1180px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar {
          position: static;
          height: auto;
        }
        .sidebar-section {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .sidebar-heading,
        .brand,
        .language-control {
          grid-column: 1 / -1;
        }
        .hero,
        .grid,
        .notice {
          grid-template-columns: 1fr;
        }
        .stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      }

      @media (max-width: 720px) {
        .shell { padding: 14px; }
        .sidebar-section,
        .stats,
        .admin-toolbar,
        .search-mode,
        .form-grid,
        .mini,
        .report-strip {
          grid-template-columns: 1fr;
        }
        .hero-panel { padding: 22px; }
        .hero-panel h1 { font-size: 31px; }
        .section-title { display: block; }
      }
    </style>
  </head>
