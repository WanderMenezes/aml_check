        const supportedLocales = ["pt", "en"];
        const serverLocale = "pt";
        const params = new URLSearchParams(window.location.search);

        function normalizeLocale(value) {
          const locale = String(value || "").toLowerCase().split("-")[0];
          return supportedLocales.includes(locale) ? locale : null;
        }

        function readStoredLocale() {
          try {
            return window.localStorage.getItem("aml_portal_locale");
          } catch (error) {
            return null;
          }
        }

        function writeStoredLocale(locale) {
          try {
            window.localStorage.setItem("aml_portal_locale", locale);
          } catch (error) {
            return;
          }
        }

        function updateUrlLocale(locale) {
          const nextUrl = new URL(window.location.href);
          nextUrl.searchParams.set("lang", locale);
          window.history.replaceState({}, "", nextUrl);
        }

        function applyLocale(locale, syncUrl) {
          const nextLocale = normalizeLocale(locale) || "pt";
          const dictionary = translations[nextLocale];
          document.documentElement.lang = nextLocale;
          document.title = dictionary.title;
          document.cookie = "aml_portal_locale=" + nextLocale + "; path=/; max-age=31536000; SameSite=Lax";
          writeStoredLocale(nextLocale);

          document.querySelectorAll("[data-i18n]").forEach(function (element) {
            const key = element.getAttribute("data-i18n");
            if (dictionary[key]) element.textContent = dictionary[key];
          });

          document.querySelectorAll("[data-i18n-aria-label]").forEach(function (element) {
            const key = element.getAttribute("data-i18n-aria-label");
            if (dictionary[key]) element.setAttribute("aria-label", dictionary[key]);
          });

          document.querySelectorAll("[data-i18n-value]").forEach(function (element) {
            const key = element.getAttribute("data-i18n-value");
            if (dictionary[key] && !element.dataset.userEdited) element.value = dictionary[key];
          });

          document.querySelectorAll("[data-lang-option]").forEach(function (button) {
            const isActive = button.getAttribute("data-lang-option") === nextLocale;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", isActive ? "true" : "false");
          });

          document.querySelectorAll("[data-locale-field]").forEach(function (field) {
            field.value = nextLocale;
          });

          applySearchMode();
          if (syncUrl) updateUrlLocale(nextLocale);
        }

        function applySearchMode() {
          const selected = document.querySelector("input[name='search_type']:checked");
          const mode = selected ? selected.value : "person";
          const locale = normalizeLocale(document.documentElement.lang) || "pt";
          const dictionary = translations[locale];
          const help = document.querySelector("[data-mode-help]");
          if (help) help.textContent = dictionary[mode + "ModeHelp"] || "";

          document.querySelectorAll("[data-mode-field]").forEach(function (field) {
            const isActive = field.getAttribute("data-mode-field") === mode;
            field.classList.toggle("is-hidden", !isActive);
            field.querySelectorAll("input, textarea, select").forEach(function (input) {
              input.disabled = !isActive;
              input.required = input.getAttribute("data-required-mode") === mode;
            });
          });
        }

        document.querySelectorAll("[data-i18n-value]").forEach(function (element) {
          element.addEventListener("input", function () {
            element.dataset.userEdited = "true";
          });
        });

        document.querySelectorAll("[data-lang-option]").forEach(function (button) {
          button.addEventListener("click", function () {
            applyLocale(button.getAttribute("data-lang-option"), true);
          });
        });

        document.querySelectorAll("input[name='search_type']").forEach(function (input) {
          input.addEventListener("change", applySearchMode);
        });

        const initialLocale = normalizeLocale(params.get("lang")) || normalizeLocale(readStoredLocale()) || normalizeLocale(serverLocale) || "pt";
        applyLocale(initialLocale, Boolean(params.get("lang")));
      })();
    </script>
